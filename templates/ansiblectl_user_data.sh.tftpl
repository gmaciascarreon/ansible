#!/bin/bash
set -euxo pipefail

hostnamectl set-hostname ${hostname}

dnf install -y python3 python3-pip

su - ec2-user -c "python3 -m venv /home/ec2-user/.venv"
su - ec2-user -c "/home/ec2-user/.venv/bin/pip install --upgrade pip"
su - ec2-user -c "/home/ec2-user/.venv/bin/pip install ansible"

mkdir -p /home/ec2-user/.ssh
cat > /home/ec2-user/.ssh/id_rsa <<'KEY'
${private_key}
KEY
chmod 700 /home/ec2-user/.ssh
chmod 600 /home/ec2-user/.ssh/id_rsa
chown -R ec2-user:ec2-user /home/ec2-user/.ssh

mkdir -p /home/ec2-user/ansible/inventory
cat > /home/ec2-user/ansible/inventory/main.yml <<INV
all:
  children:
    prod:
      hosts:
        prod:
          ansible_host: ${prod_ip}
    test:
      hosts:
        test:
          ansible_host: ${test_ip}
    dev:
      hosts:
        dev:
          ansible_host: ${dev_ip}
  vars:
    ansible_user: ec2-user
    ansible_ssh_private_key_file: /home/ec2-user/.ssh/id_rsa
    ansible_ssh_common_args: '-o StrictHostKeyChecking=no'
INV

chown -R ec2-user:ec2-user /home/ec2-user/ansible
